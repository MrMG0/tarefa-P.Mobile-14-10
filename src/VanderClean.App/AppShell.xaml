<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="VanderClean.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:VanderClean.App.Views"
    Title="ShopVander"
    BackgroundColor="White"
    Shell.ForegroundColor="{StaticResource Primary}"
    Shell.TitleColor="{StaticResource Gray900}"
    Shell.DisabledColor="{StaticResource Gray300}"
    Shell.UnselectedColor="{StaticResource Gray500}"
    Shell.NavBarHasShadow="False">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="Pedidos de Reposição"
        ContentTemplate="{DataTemplate views:PedidosPage}"
        Route="PedidosPage" />

</Shell>
