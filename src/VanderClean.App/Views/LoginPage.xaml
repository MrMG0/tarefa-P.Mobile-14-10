<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VanderClean.App.Views.LoginPage"
             Title="ShopVander - Login"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Spacing="18" Padding="28,36" VerticalOptions="Center">
            
            <Border BackgroundColor="{StaticResource Secondary}"
                    Stroke="Transparent"
                    HeightRequest="72"
                    WidthRequest="72"
                    HorizontalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="36" />
                </Border.StrokeShape>
                <Label Text="V"
                       FontSize="36"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
            </Border>

            <Label Text="ShopVander"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}"
                   HorizontalOptions="Center" />

            <Label Text="Acesso do Dono / Funcionário"
                   FontSize="16"
                   TextColor="{StaticResource Gray600}"
                   HorizontalOptions="Center" />

            <Border BackgroundColor="White" Stroke="{StaticResource Gray200}" StrokeThickness="1" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="15">
                    
                    <Label Text="E-mail Corporativo" TextColor="{StaticResource Gray600}" FontSize="14" />
                    <Entry x:Name="EmailEntry"
                           Placeholder="ex: contato@vanderclean.com.br"
                           Text="contato@vanderclean.com.br"
                           TextColor="{StaticResource Gray900}"
                           PlaceholderColor="{StaticResource Gray500}"
                           Keyboard="Email"
                           BackgroundColor="{StaticResource Gray100}" />

                    <Label Text="Senha" TextColor="{StaticResource Gray600}" FontSize="14" />
                    <Entry x:Name="SenhaEntry"
                           Placeholder="Sua senha"
                           Text="123456"
                           IsPassword="True"
                           TextColor="{StaticResource Gray900}"
                           PlaceholderColor="{StaticResource Gray500}"
                           BackgroundColor="{StaticResource Gray100}" />

                    <Button x:Name="BtnEntrar"
                            Text="ENTRAR"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="50"
                            Clicked="OnLoginClicked" />

                    <ActivityIndicator x:Name="LoadingIndicator"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Color="{StaticResource Primary}" />

                </VerticalStackLayout>
            </Border>

            <Button Text="Cadastrar Minha Empresa"
                    TextColor="{StaticResource Primary}"
                    BackgroundColor="Transparent"
                    FontAttributes="Bold"
                    Clicked="OnRegistrarClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
