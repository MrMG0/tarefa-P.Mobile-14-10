<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VanderClean.App.Views.LoginPage"
             Title="ShopVander - Login"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0f172a">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">
            
            <Image Source="dotnet_bot.png"
                   HeightRequest="90"
                   HorizontalOptions="Center" />

            <Label Text="ShopVander"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#38bdf8"
                   HorizontalOptions="Center" />

            <Label Text="Acesso do Dono / Funcionário"
                   FontSize="16"
                   TextColor="#94a3b8"
                   HorizontalOptions="Center" />

            <Border BackgroundColor="#1e293b" Stroke="#334155" StrokeThickness="1" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="15">
                    
                    <Label Text="E-mail Corporativo" TextColor="#cbd5e1" FontSize="14" />
                    <Entry x:Name="EmailEntry"
                           Placeholder="ex: contato@vanderclean.com.br"
                           Text="contato@vanderclean.com.br"
                           TextColor="White"
                           PlaceholderColor="#64748b"
                           Keyboard="Email"
                           BackgroundColor="#0f172a" />

                    <Label Text="Senha" TextColor="#cbd5e1" FontSize="14" />
                    <Entry x:Name="SenhaEntry"
                           Placeholder="Sua senha"
                           Text="123456"
                           IsPassword="True"
                           TextColor="White"
                           PlaceholderColor="#64748b"
                           BackgroundColor="#0f172a" />

                    <Button x:Name="BtnEntrar"
                            Text="ENTRAR"
                            BackgroundColor="#0284c7"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="50"
                            Clicked="OnLoginClicked" />

                    <ActivityIndicator x:Name="LoadingIndicator"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Color="#38bdf8" />

                </VerticalStackLayout>
            </Border>

            <Button Text="Cadastrar Minha Empresa"
                    TextColor="#38bdf8"
                    BackgroundColor="Transparent"
                    FontAttributes="Bold"
                    Clicked="OnRegistrarClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
