<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VanderClean.App.Views.NovoPedidoPage"
             Title="Novo Pedido de Reposição"
         BackgroundColor="White">

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- Filtro por Categoria -->
        <Border Grid.Row="0"
                BackgroundColor="White"
                Stroke="{StaticResource Gray200}"
                StrokeThickness="1"
                Padding="10"
                Margin="10,5">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="5">
                <Label Text="Filtrar por Categoria:" TextColor="{StaticResource Gray600}" FontSize="12" />
                <Picker x:Name="CategoriaPicker"
                        Title="Todas as Categorias"
                        TextColor="{StaticResource Gray900}"
                        TitleColor="{StaticResource Gray500}"
                        BackgroundColor="{StaticResource Gray100}"
                        ItemDisplayBinding="{Binding Nome}"
                        SelectedIndexChanged="OnCategoriaChanged" />
            </VerticalStackLayout>
        </Border>

        <!-- Catálogo de Produtos com Seletores de Quantidade -->
        <CollectionView Grid.Row="1"
                        x:Name="ProdutosCollectionView"
                        SelectionMode="None"
                        Margin="10,0">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="10"
                                     Padding="24">
                    <Label Text="Nenhum produto disponível nesta categoria."
                           TextColor="{StaticResource Gray600}"
                           HorizontalTextAlignment="Center" />
                    <Button Text="Tentar novamente"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            Clicked="OnTentarNovamenteClicked" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="White"
                            Stroke="{StaticResource Gray200}"
                            StrokeThickness="1"
                            Margin="0,4"
                            Padding="12">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                <Label Text="{Binding Produto.Nome}"
                                       TextColor="{StaticResource Gray900}"
                                       FontAttributes="Bold"
                                       FontSize="15" />
                                <Label Text="{Binding Produto.Descricao}"
                                       TextColor="{StaticResource Gray600}"
                                       FontSize="12"
                                       MaxLines="2" />
                                <Label Text="{Binding Produto.Preco, StringFormat='R$ {0:F2}'}"
                                       TextColor="{StaticResource Primary}"
                                       FontAttributes="Bold"
                                       FontSize="14" />
                            </VerticalStackLayout>

                            <!-- Controles de Quantidade +/- -->
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <Button Text="-"
                                        BackgroundColor="{StaticResource Gray200}"
                                        TextColor="{StaticResource Gray900}"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        CornerRadius="18"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnDiminuirQtdClicked" />

                                <Label Text="{Binding Quantidade}"
                                       TextColor="{StaticResource Gray900}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       WidthRequest="30" />

                                <Button Text="+"
                                        BackgroundColor="{StaticResource Primary}"
                                        TextColor="White"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        CornerRadius="18"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnAumentarQtdClicked" />
                            </HorizontalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Rodapé com Total e Botão de Finalizar Pedido -->
        <Border Grid.Row="2"
                BackgroundColor="White"
                Stroke="{StaticResource Gray200}"
                StrokeThickness="1"
                Padding="15"
                Margin="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Total Estimado:" TextColor="{StaticResource Gray600}" FontSize="12" />
                    <Label x:Name="TotalLabel"
                           Text="R$ 0,00"
                           TextColor="{StaticResource Primary}"
                           FontAttributes="Bold"
                           FontSize="20" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        x:Name="BtnConfirmar"
                        Text="CONFIRMAR PEDIDO"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="48"
                        Clicked="OnConfirmarPedidoClicked" />
            </Grid>
        </Border>

    </Grid>

</ContentPage>
