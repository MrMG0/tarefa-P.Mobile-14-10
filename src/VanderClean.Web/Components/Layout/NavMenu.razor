@implements IDisposable
@inject CartService Cart
@inject WebSessionState Session

<div class="top-row ps-3 navbar">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="">VanderClean</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-shop" aria-hidden="true"></span> Catálogo
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="carrinho">
                <span class="bi bi-cart3" aria-hidden="true"></span> Carrinho
                @if (Cart.TotalItens > 0)
                {
                    <span class="badge bg-success ms-auto">@Cart.TotalItens</span>
                }
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="encomendas">
                <span class="bi bi-receipt" aria-hidden="true"></span> Minhas Encomendas
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="login">
                <span class="bi bi-person-circle" aria-hidden="true"></span> @(Session.IsAutenticado ? Session.ClienteNome : "Entrar / Cadastro")
            </NavLink>
        </div>
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        Cart.OnChange += OnCartChanged;
    }

    private void OnCartChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Cart.OnChange -= OnCartChanged;
}
