@page "/"
@rendermode InteractiveServer
@inject WebApiService Api
@inject CartService Cart
@inject NavigationManager Nav
@inject WebSessionState Session

<PageTitle>ShopVander - Loja Online VanderClean</PageTitle>

<div class="container py-4">
    <!-- Banner de Boas-vindas -->
    <div class="p-4 mb-4 rounded-3 text-white" style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-6 fw-bold">ShopVander - Produtos VanderClean</h1>
                <p class="lead mb-0">Linha completa de produtos de limpeza profissionais e domésticos. Faça sua encomenda online com entrega rápida.</p>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                @if (Session.IsAutenticado)
                {
                    <div class="badge bg-light text-dark p-2 fs-6">Olá, @Session.ClienteNome!</div>
                }
                else
                {
                    <a href="/login" class="btn btn-light fw-bold text-primary">Entrar / Criar Conta</a>
                }
            </div>
        </div>
    </div>

    <!-- Barra de Filtros por Categoria -->
    <div class="d-flex flex-wrap gap-2 mb-4 align-items-center">
        <span class="fw-bold text-secondary me-2">Categorias:</span>
        <button class="btn btn-sm @(categoriaSelecionada == null ? "btn-primary" : "btn-outline-secondary")" @onclick="() => SelecionarCategoria(null)">
            Todas
        </button>
        @foreach (var cat in categorias)
        {
            <button class="btn btn-sm @(categoriaSelecionada == cat.Id ? "btn-primary" : "btn-outline-secondary")" @onclick="() => SelecionarCategoria(cat.Id)">
                @cat.Nome
            </button>
        }
    </div>

    <!-- Grid de Produtos -->
    @if (carregando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Carregando catálogo...</p>
        </div>
    }
    else if (!produtos.Any())
    {
        <div class="alert alert-info text-center">Nenhum produto disponível nesta categoria no momento.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var prod in produtos)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        @if (!string.IsNullOrEmpty(prod.ImagemUrl))
                        {
                            <img src="@prod.ImagemUrl" class="card-img-top" style="height: 180px; object-fit: cover;" alt="@prod.Nome" />
                        }
                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-secondary mb-2 align-self-start">@prod.Categoria?.Nome</span>
                            <h5 class="card-title fw-bold text-dark">@prod.Nome</h5>
                            <p class="card-text text-muted small flex-grow-1">@prod.Descricao</p>
                            
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <div>
                                    <span class="fs-5 fw-bold text-success">R$ @prod.Preco.ToString("F2")</span>
                                    <small class="text-muted d-block">Estoque: @prod.Estoque un</small>
                                </div>
                                <button class="btn btn-primary" @onclick="() => AdicionarAoCarrinho(prod)">
                                    + Adicionar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (mensagemSucesso != null)
{
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
        <div class="alert alert-success shadow alert-dismissible fade show" role="alert">
            @mensagemSucesso
            <button type="button" class="btn-close" @onclick="() => mensagemSucesso = null"></button>
        </div>
    </div>
}

@code {
    private List<Categoria> categorias = new();
    private List<Produto> produtos = new();
    private int? categoriaSelecionada = null;
    private bool carregando = true;
    private string? mensagemSucesso;

    protected override async Task OnInitializedAsync()
    {
        categorias = await Api.ObterCategoriasAsync();
        await CarregarProdutos();
    }

    private async Task SelecionarCategoria(int? id)
    {
        categoriaSelecionada = id;
        await CarregarProdutos();
    }

    private async Task CarregarProdutos()
    {
        carregando = true;
        produtos = await Api.ObterProdutosAsync(categoriaSelecionada);
        carregando = false;
    }

    private void AdicionarAoCarrinho(Produto prod)
    {
        Cart.Adicionar(prod, 1);
        mensagemSucesso = $"'{prod.Nome}' adicionado à encomenda!";
    }
}
