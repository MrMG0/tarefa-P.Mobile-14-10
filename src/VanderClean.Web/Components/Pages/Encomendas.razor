@page "/encomendas"
@rendermode InteractiveServer
@inject WebApiService Api
@inject WebSessionState Session
@inject NavigationManager Nav

<PageTitle>Minhas Encomendas - ShopVander</PageTitle>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Minhas Encomendas</h2>
        <a href="/" class="btn btn-outline-primary">+ Fazer Nova Encomenda</a>
    </div>

    @if (!Session.IsAutenticado)
    {
        <div class="card p-5 text-center shadow-sm border-0">
            <h4>Acesse sua conta para ver suas encomendas</h4>
            <div class="mt-3">
                <a href="/login" class="btn btn-primary">Fazer Login</a>
            </div>
        </div>
    }
    else if (carregando)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Carregando histórico...</p>
        </div>
    }
    else if (!encomendas.Any())
    {
        <div class="alert alert-info text-center py-4">
            Você ainda não realizou nenhuma encomenda na loja VanderClean.
        </div>
    }
    else
    {
        @if (feedbackMsg != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4">
                @feedbackMsg
                <button type="button" class="btn-close" @onclick="() => feedbackMsg = null"></button>
            </div>
        }

        <div class="vstack gap-3">
            @foreach (var enc in encomendas)
            {
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                        <div>
                            <span class="fw-bold fs-5">Encomenda #@enc.Id</span>
                            <span class="text-muted ms-2 small">Data: @enc.DataEncomenda.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary fs-6">@enc.Status</span>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => Repetir(enc.Id)">
                                ↻ Repetir Encomenda
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <ul class="list-group list-group-flush">
                            @foreach (var it in enc.Itens)
                            {
                                <li class="list-group-item d-flex justify-content-between px-0">
                                    <span>@it.Produto?.Nome (x@it.Quantidade)</span>
                                    <span class="fw-bold">R$ @it.Subtotal.ToString("F2")</span>
                                </li>
                            }
                        </ul>
                        <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                            <small class="text-muted">Prazo fixo de entrega: 3 dias úteis</small>
                            <span class="fs-5 fw-bold text-success">Total: R$ @enc.ValorTotal.ToString("F2")</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Encomenda> encomendas = new();
    private bool carregando = true;
    private string? feedbackMsg;

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsAutenticado && Session.ClienteId.HasValue)
        {
            await Carregar();
        }
        else
        {
            carregando = false;
        }
    }

    private async Task Carregar()
    {
        carregando = true;
        encomendas = await Api.ObterEncomendasClienteAsync(Session.ClienteId!.Value);
        carregando = false;
    }

    private async Task Repetir(int id)
    {
        var res = await Api.RepetirEncomendaAsync(id);
        if (res.Sucesso)
        {
            feedbackMsg = $"Nova encomenda gerada a partir da encomenda #{id}!";
            await Carregar();
        }
        else
        {
            feedbackMsg = res.Mensagem;
        }
    }
}
